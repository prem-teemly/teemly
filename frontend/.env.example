# The browser calls /api/* on this same origin; Next.js forwards it to the backend (next.config.ts).
# Same origin keeps the sign-in cookie first-party. Change only if the backend runs elsewhere.
BACKEND_URL=http://127.0.0.1:8000

# Leave unset. Pointing the browser straight at the backend (another origin) breaks the sign-in cookie.
# NEXT_PUBLIC_API_BASE_URL=
