# Copy this file to .env.
#
# Google Cloud / Gemini (Vertex AI). Authentication uses Application Default Credentials (ADC);
# there is no API key. Locally run:  gcloud auth application-default login
# In deployment set GOOGLE_APPLICATION_CREDENTIALS or attach the gemini-app-backend service account.
GOOGLE_CLOUD_PROJECT=project-7c7a86a2-b174-4f5d-8c5
GOOGLE_CLOUD_LOCATION=global
# gemini-2.5-flash was retired on Vertex AI on 2026-10-20; gemini-3.8-flash is its replacement.
GEMINI_TRANSCRIBE_MODEL=gemini-3.8-flash
GEMINI_TEXT_MODEL=gemini-3.8-flash

# Optional settings (defaults shown).
# HOST=127.0.0.1
# PORT=8000
# JOB_CONCURRENCY=3
# GEMINI_CONCURRENCY=4
# TRANSCRIBE_CHUNK_SECONDS=300
# TRANSCRIBE_VOCABULARY=Teemly
# TRANSCRIBE_LANGUAGE_CODES=ta-IN,en-IN   (only for GEMINI_TRANSCRIBE_MODEL=gemini-3.5-transcribe)
# TRANSCRIBE_FALLBACK=true
# PULSE_THINKING_LEVEL=low
# ANALYSIS_THINKING_LEVEL=low
# GEMINI_TEXT_TIMEOUT_SECONDS=120
# GEMINI_TIMEOUT_SECONDS=300
# FRONTEND_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# DIARIZATION_THRESHOLD=0.75   (lower = more speakers; 0.5 over-split, 0.8 merged speakers in tests)
# DIARIZATION_THREADS=        (default: half the CPU cores)
# MODELS_DIR=./models

# --- MySQL persistence (optional: without DB_USER the API works in memory only, as before) ---
# Users are created once by an administrator with db/setup/create_users.template.sql.
# Never put MySQL root credentials here.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=teemly_db
DB_USER=teemly_app
DB_PASSWORD=change-me
DB_MIGRATION_USER=teemly_migrator
DB_MIGRATION_PASSWORD=change-me
# DB_CONNECTION_LIMIT=10
# DB_ENABLED=true
# Key for hashing client addresses in audit logs (any long random string)
AUDIT_HASH_KEY=change-me

# Uploaded originals are kept (0 = never delete). Set hours only to enable automatic deletion;
# files used by a running job are never deleted.
UPLOAD_RETENTION_HOURS=0

# Optional: path to an ffprobe binary (default: the one installed by @ffprobe-installer/ffprobe)
# FFPROBE_PATH=

# --- Audio storage: local (default) or oci. With oci, originals also go to a PRIVATE OCI Object
# Storage bucket (backend only; nothing reaches the frontend). Never commit real values or key files.
# STORAGE_PROVIDER=local
# OCI_AUTH=api_key                 # api_key | config_file | instance_principal
# OCI_TENANCY_OCID=ocid1.tenancy.oc1..
# OCI_USER_OCID=ocid1.user.oc1..
# OCI_FINGERPRINT=aa:bb:...
# OCI_PRIVATE_KEY_PATH=C:/secure/oci_api_key.pem   # a file path, never the key itself
# OCI_PRIVATE_KEY_PASSPHRASE=
# OCI_REGION=ap-mumbai-1
# OCI_NAMESPACE=
# OCI_BUCKET=teemly-audio
# OCI_OBJECT_PREFIX=audio/
# OCI_CONFIG_FILE=                 # config_file mode: path to ~/.oci/config
# OCI_CONFIG_PROFILE=DEFAULT
# OCI_MAX_ATTEMPTS=4
# OCI_RETRY_DELAY_MS=500

# --- Production
# On the hosted server: NODE_ENV=production (Secure cookie, API docs off, HSTS, codes never printed).
# The backend refuses to start in production without OWNER_EMAIL (it would be open to anyone).
# NODE_ENV=production
# The owner's time zone ("today", due dates, overdue, the day-end digest). Default Asia/Kolkata, so a
# cloud server running in UTC still gives Indian dates. (MySQL should also use +05:30.)
# APP_TIMEZONE=Asia/Kolkata
# Proxies in front of the backend besides this machine, e.g. an AWS load balancer's subnet, so the
# rate limit sees each visitor's address: comma-separated addresses or IPv4 ranges.
# TRUSTED_PROXIES=10.0.0.0/16
# API docs (/docs): on in development, off when NODE_ENV=production unless API_DOCS=true.
# API_DOCS=false

# --- Sign-in (email + one-time code). Login is OFF until OWNER_EMAIL is set. Needs migrations 003 and
# 019 (npm run db:migrate). Only these emails can sign in (comma-separated).
# OWNER_EMAIL=you@example.com
# OWNER_NAME=Your Name
# The code is emailed through SMTP. Gmail: 2-Step Verification on, then an App Password from
# https://myaccount.google.com/apppasswords (16 letters; spaces are fine).
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_USER=you@gmail.com
# SMTP_PASS=
# SMTP_FROM=Teemly <you@gmail.com>
# auto (default) = SMTP when SMTP_PASS is set, otherwise console: the code is printed in this terminal
# (development only; refused when NODE_ENV=production).
# OTP_PROVIDER=auto
# OTP_TTL_SECONDS=300
# OTP_MAX_ATTEMPTS=5
# OTP_RESEND_SECONDS=30
# OTP_MAX_PER_HOUR=5
# SESSION_DAYS=7
# COOKIE_SECURE=false              # true on HTTPS (default true when NODE_ENV=production)
